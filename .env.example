# Copy to .env (gitignored) and fill in. PodTerm loads .env at startup.

# RunPod console session cookie (__client), used to mint short-lived Clerk JWTs
# for the hapi.runpod.net boot-logs endpoint — this powers the pod image-pull
# progress panel. The RunPod API key does NOT work for that endpoint.
#
# How to get it: log in to https://console.runpod.io, open Chrome DevTools →
# Application → Cookies → https://clerk.runpod.io → copy the __client value.
# It's long-lived but Clerk rotates it occasionally; if boot progress stops
# showing, paste a fresh value here. Optional — without it, everything else
# works and the boot panel simply doesn't appear.
RUNPOD_CONSOLE_CLIENT_COOKIE=

# Kill-switch for the boot/image-pull progress path (hapi polling + boot panel).
# On by default. Set to 0/false/no/off to fully disable it — e.g. during a demo
# if the console cookie has gone stale and the panel would sit empty.
PODTERM_BOOT_PROGRESS=1

# --- Off-pod model-health diagnostics -------------------------------------
# PodTerm pulls model snapshots from each run and runs the diagnostics suite
# locally (podterm/diagnostics/), off the training GPU. It executes as a
# subprocess under gpt-golf's torch env, importing the model from that checkout.

# Master switch. Set to 0/false to skip downloading/running diagnostics entirely.
DIAG_ENABLED=1

# Path to the sibling gpt-golf checkout (provides the model + torch env + the
# local val shard/tokenizer). Defaults to ../gpt-golf relative to PodTerm's cwd.
# GPT_GOLF_DIR=../gpt-golf

# How the diagnostics subprocess is launched (run with cwd=GPT_GOLF_DIR so it
# uses gpt-golf's environment). Override with an explicit interpreter if needed.
# DIAG_PYTHON=uv run --no-sync python

# Device for the diagnostics run: auto (probe gpt-golf's torch for CUDA), cpu,
# or an explicit cuda device. On cpu the forward/token stages are skipped
# (weights-only); GPU runs the full suite.
DIAG_DEVICE=auto

# Bound the per-snapshot forward sweep cost (read by the diagnostics config).
# DIAG_MAX_BATCHES=2
# DIAG_ENTROPY_BATCHES=1
# DIAG_SAMPLE_TOKENS=0       # sampling off by default (needs tokenizer, slow)

# Force weights-only even on GPU (skip all token/forward stages).
# DIAG_NO_TOKENS=0

# Before a token-requiring (GPU) run, ensure the val shard + tokenizer for the run's variant are
# cached locally in gpt-golf's data dir (via gpt-golf's downloader, --train-shards 0). On by
# default; the first snapshot pays the HuggingFace download and the rest reuse it. Set to 0/false
# if the val shard is provisioned out-of-band and PodTerm should not reach out to HuggingFace —
# if it's then missing, the run degrades to weights-only.
# DIAG_CACHE_VAL_SHARD=1
# DIAG_VAL_SHARD_TIMEOUT=600   # seconds to wait for the val-shard download subprocess
