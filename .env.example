# Copy to .env (gitignored) and fill in. PodTerm loads .env at startup.

# RunPod console session cookie (__client), used to mint short-lived Clerk JWTs
# for the hapi.runpod.net boot-logs endpoint — this powers the pod image-pull
# progress panel. The RunPod API key does NOT work for that endpoint.
#
# How to get it: log in to https://console.runpod.io, open Chrome DevTools →
# Application → Cookies → https://clerk.runpod.io → copy the __client value.
# It's long-lived but Clerk rotates it occasionally; if boot progress stops
# showing, paste a fresh value here. Optional — without it, everything else
# works and the boot panel simply doesn't appear.
RUNPOD_CONSOLE_CLIENT_COOKIE=

# Kill-switch for the boot/image-pull progress path (hapi polling + boot panel).
# On by default. Set to 0/false/no/off to fully disable it — e.g. during a demo
# if the console cookie has gone stale and the panel would sit empty.
PODTERM_BOOT_PROGRESS=1
